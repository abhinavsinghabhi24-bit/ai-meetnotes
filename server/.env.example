# ─── Server Configuration ────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ─── Database ────────────────────────────────────────────────────────
DB_PATH=./data/meetnotes.db

# ─── AI Meeting Analysis Configuration (Phase 3) ─────────────────────
# Choose ONE of the providers below:

# Option 1: Google Gemini (RECOMMENDED - Free tier in Google AI Studio)
# Get key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Option 2: OpenAI
# Get key at: https://platform.openai.com/api-keys
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# Option 3: Groq (Ultra-fast Llama 3 inference - Free tier available)
# Get key at: https://console.groq.com/keys
# GROQ_API_KEY=your_groq_api_key_here
# GROQ_MODEL=llama-3.3-70b-versatile
